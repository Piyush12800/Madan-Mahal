# Serve the single-page app from real URLs.
#
# Without this, /catalogue returns a 404 from Apache because no such file exists
# on disk. The old site avoided the problem by putting everything behind /#/,
# which also kept it out of Google. This is the fix for shared Apache hosting.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone (assets, images, robots.txt).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets can be cached hard.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  # index.html must not be, or nobody sees updates.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
